{
  "name": "FFmpeg macOS audio decoder",
  "version": "9.0.2",
  "upstream": "https://ffmpeg.org",
  "license": "LGPL-2.1-or-later",
  "licenseUrl": "https://ffmpeg.org/legal.html",
  "tarball": "https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz",
  "tarballSha256": "8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e",
  "releaseSigningFingerprint": "FCF986EA15E6E293A5644F10B4322F04D67658D8",
  "binary": "ffmpeg",
  "platforms": [
    "macos-arm64",
    "macos-x64"
  ],
  "configureFlags": [
    "--disable-everything",
    "--disable-autodetect",
    "--disable-doc",
    "--disable-network",
    "--disable-gpl",
    "--disable-nonfree",
    "--disable-version3",
    "--disable-shared",
    "--enable-static",
    "--enable-small",
    "--disable-programs",
    "--enable-ffmpeg",
    "--disable-avdevice",
    "--disable-swscale",
    "--disable-videotoolbox",
    "--disable-audiotoolbox",
    "--disable-securetransport",
    "--disable-asm",
    "--disable-debug",
    "--disable-iconv",
    "--enable-avfilter",
    "--enable-swresample",
    "--enable-filter=aresample,aformat,anull",
    "--enable-protocol=file",
    "--enable-demuxer=matroska,avi,wav,ogg,mp3,mov,flac,aac,aiff,caf,asf",
    "--enable-decoder=aac,aac_fixed,alac,flac,mp3,mp3float,opus,vorbis,wmav1,wmav2,adpcm_ima_wav,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le,pcm_f64le,pcm_u8,pcm_mulaw,pcm_alaw,pcm_s16be,pcm_s24be,pcm_s32be,pcm_f32be,pcm_f64be,pcm_s8",
    "--enable-parser=aac,mpegaudio,opus,vorbis,flac",
    "--enable-encoder=pcm_s16le",
    "--enable-muxer=wav",
    "--cc=/usr/bin/clang",
    "--ld=/usr/bin/clang",
    "--extra-cflags=-mmacosx-version-min=12.0",
    "--extra-ldflags=-mmacosx-version-min=12.0"
  ],
  "distribution": "Standalone executable through argv; no OciDeck linking. Complete corresponding source and build recipe travel inside the app. No network protocols or external codec libraries, GPL, nonfree or version3 components.",
  "minimumMacOS": "12.0"
}
