# Instellingen voor de gepinde Jitsi-teststack (#2540).
# Setup: `cp .env.example .env && ./run.sh init && ./run.sh up`

# --- Pin: imageversie van alle vier de services -------------------------
# Alleen bewust aanpassen. Deze versie staat in elk bewijsformulier; een
# stille upgrade maakt een gedocumenteerde proef ongeldig.
JITSI_IMAGE_REPO=ghcr.io/jitsi
JITSI_IMAGE_VERSION=stable-11248

# Gegenereerde runtime-config (certs, prosody-data) — staat in .gitignore.
CONFIG=./config
TZ=UTC

# Loopback-only web-UI. Zonder geldig certificaat is HTTP op localhost de
# aangewezen route: browsers behandelen http://localhost als secure context,
# dus getUserMedia/WebRTC werkt. Houd HTTP_PORT en PUBLIC_URL gelijk.
HTTP_PORT=8000
PUBLIC_URL=http://localhost:8000
DISABLE_HTTPS=1
ENABLE_LETSENCRYPT=0

# Directe Prosody-WebSocket voor toekomstige OciDeck-clients (#2533+).
PROSODY_WS_PORT=15280

# Twee echte identiteiten + een weigerpad: geregistreerde accounts mogen een
# kamer openen, gasten wachten in de lobby. `./run.sh users` maakt host/guest.
AUTH_TYPE=internal
ENABLE_AUTH=1
ENABLE_GUESTS=1

# P2P uit: met precies twee deelnemers zou Jitsi peer-to-peer gaan en de
# JVB/SFU-route — wat de OciDeck-adapter gaat implementeren — nooit raken.
ENABLE_P2P=0

# Hermetisch: geen externe STUN-/harvest-verzoeken en geen third-party calls
# vanuit de client, zodat het netwerkbewijs alleen signalling + SFU hoeft te
# onderscheiden.
JVB_DISABLE_STUN=1
DISABLE_AWS_HARVESTER=1
ENABLE_THIRD_PARTY_REQUESTS=0

# JVB adverteert loopback; browsers op deze machine bereiken UDP 10000 direct.
JVB_ADVERTISE_IPS=127.0.0.1
DOCKER_HOST_ADDRESS=127.0.0.1
JVB_PORT=10000

# Service-accountwachtwoorden, gegenereerd door `./run.sh init`.
# Nooit committen: .env staat in .gitignore én in de secret-scan-allowlists.
JICOFO_AUTH_PASSWORD=
JICOFO_COMPONENT_SECRET=
JVB_AUTH_PASSWORD=
