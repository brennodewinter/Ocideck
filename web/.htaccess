# OciDeck — HTTP security response headers for an Apache static host.
#
# WHY THIS FILE EXISTS
# The web bundle ships a Content-Security-Policy and a Referrer-Policy as <meta>
# tags inside index.html, but a browser ignores `frame-ancestors` (and
# `sandbox`/`report-*`) unless the CSP arrives as a real HTTP response header —
# see the long comment in web/index.html. Several hardening headers
# (Strict-Transport-Security, X-Frame-Options, Permissions-Policy) have no <meta>
# form at all. This file supplies the header form so those directives are
# actually enforced, and it travels *with* the bundle: `flutter build web` copies
# web/.htaccess to build/web/.htaccess, so the hardening ships next to the code
# instead of living only in server config nobody re-checks.
#
# PRECONDITIONS ON THE HOST
#   * mod_headers must be enabled (`a2enmod headers`).
#   * `AllowOverride` for the web root must permit `FileInfo` (or `All`) so a
#     per-directory .htaccess may set headers. Where AllowOverride is Off — the
#     common hardened default — this file is ignored and the same directives must
#     go in the vhost/server config. The exact block is in docs/HOSTING.md §3 and
#     the per-server snippets in docs/BUILD.md.
#   * Apache denies serving `.ht*` files by default, so this file is applied but
#     never itself downloadable. The bundle's SHA256SUMS lists it for
#     completeness; nothing fetches it.
#
# The HTTP CSP matches the meta policy plus the header-only frame-ancestors
# directive. Both policies apply cumulatively; source and built-bundle checks
# preserve their common directives without putting invalid directives in meta.

# Suppress Apache's footer on generated error pages, including 404 responses.
# ServerTokens is server-wide and belongs in the host config (HOSTING.md §3).
ServerSignature Off

<IfModule mod_headers.c>
  # Keep header-only clickjacking protection out of the meta policy.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: wss: blob:; worker-src 'self' blob:; child-src 'self' blob: data:; frame-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"

  # Clickjacking control for browsers that predate frame-ancestors. Matches it.
  Header always set X-Frame-Options "DENY"

  # No MIME sniffing — a response is served as its declared Content-Type.
  Header always set X-Content-Type-Options "nosniff"

  # Reinforces the <meta name="referrer"> the bundle already carries: the deck's
  # own URL must not leak to a URL-import target in the Referer header.
  Header always set Referrer-Policy "no-referrer"

  # Powerful features the app never uses are switched off; the media-related ones
  # stay `self` because the presenter goes fullscreen and video slides play/PiP
  # first-party. Camera, microphone and display-capture stay `self` for the
  # videocalls module — `(self)` only lifts the blanket ban; the browser still
  # asks the user per site before any capture starts. (Remote embeds are
  # blocked on web by the CSP frame-src anyway.)
  Header always set Permissions-Policy "accelerometer=(), autoplay=(self), camera=(self), display-capture=(self), encrypted-media=(self), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), midi=(), payment=(), picture-in-picture=(self), usb=()"

  # HSTS. Conservative on purpose: two years + includeSubDomains, but NO preload.
  # includeSubDomains here binds only *.<this-host>, not sibling subdomains of the
  # parent domain; preload is the sticky, hard-to-undo commitment and is left out.
  # The site is served over HTTPS only, so this costs nothing and closes the
  # plaintext-downgrade window on the first schemeless request. See HOSTING.md §3.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

  # Cross-origin isolation: required for SharedArrayBuffer, which the
  # pthread-based whisper WASM engine needs for local transcription (#2513).
  # Safe to set here because the CSP above already confines every subresource
  # axis (img/media/frame) to 'self', blob: and data: — COEP's no-cors gate
  # therefore has nothing left to break. The user-initiated model download is
  # a CORS fetch, which COEP does not govern.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"

  # Resources belong to this origin. This restricts other sites' no-cors loads;
  # it does not block our CORS fetches or change COOP/COEP isolation. Hosts that
  # deliberately share individual files must override CORP for those files.
  Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

# Streaming WebAssembly compilation and ES modules require correct MIME types.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType text/javascript .mjs
</IfModule>

# Compress modules as well as JS, manifests and fonts when mod_deflate is enabled.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain image/svg+xml application/wasm text/javascript application/javascript application/json application/octet-stream font/ttf font/otf
</IfModule>

<IfModule mod_headers.c>
  # Revalidate stable URLs, including CanvasKit/skwasm: engine filenames are
  # NOT content-hashed. Never pin an old engine to a new compiled application.
  Header always set Cache-Control "no-cache"
  # Only Flutter's content-addressed entrypoints and assets are immutable.
  <FilesMatch "\.[0-9a-f]{8}\.(js|mjs|wasm|json|bin|md|png|jpg|jpeg|webp|svg|ttf|otf|woff2?)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
